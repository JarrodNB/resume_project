{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-branches.sh",
            "onFailure": "block",
            "statusMessage": "Checking branch protection"
          }
        ]
      }
    ]
  }
}
