{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-branches.sh\"; [ -f \"$f\" ] || f=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/../.claude/hooks/protect-branches.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "statusMessage": "Checking branch protection"
          }
        ]
      }
    ]
  }
}
