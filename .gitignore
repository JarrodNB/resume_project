# Repository ignore rules for secrets, local files, and generated artifacts.
# Index: secrets, editors, Node, Rails, Python, Terraform, local notes.

# Secrets / env
.env
.env.*
!.env.example
.aws/
.ssh/
.netrc
.git-credentials
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Node
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo

# Ruby / Rails
.bundle/
vendor/bundle/
services/api/config/master.key
services/api/config/credentials/*.key
services/api/log/*
services/api/tmp/*
services/api/storage/*
!services/api/log/.keep
!services/api/tmp/.keep
!services/api/tmp/pids/
services/api/tmp/pids/*
!services/api/tmp/pids/.keep
!services/api/storage/.keep

# Python
services/ai/conversation_logs/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*.tfplan
crash.log
crash.*.log


# Local notes / downloaded reference docs
/.native/
/initial_project_description_and_notes.txt
/running_notes.txt
/docs/pydanticAI/
/docs/evals/*
/docs/research/*
!docs/research/cleanjobdata-api.md
/docs/plans/*
Workflow.md
KANBAN.md
