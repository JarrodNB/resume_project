  "narrative": {
    "northStar": "The Career Folio",
    "overview": "The career folio presents career evidence as an ordered personal record. Warm paper, forest ink, restrained selection, and ruled rows keep long editing sessions calm and readable.\n\nThe main web app shares this system across signed-in tools and authentication. The separate marketing landing page is outside this specification.",
    "keyCharacteristics": [
      "Quiet surfaces and visible current location.",
      "Clear page titles and restrained action hierarchy.",
      "Remembered disclosures and structurally responsive navigation."
    ],
    "rules": [
      {
        "name": "The Quiet Record Rule",
        "body": "Let evidence and headings carry the page; use borders rather than colored section bands to organize records.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic theme variables in both color modes.",
      "Do preserve disclosure state and keep the current navigation item visible.",
      "Do use quiet rules to separate career records."
    ],
    "donts": [
      "Don't restore colored header bands or accent stripes to section cards.",
      "Don't replace the mobile navigation with a clipped desktop sidebar.",
      "Don't treat the marketing landing page as covered by this workspace system."
    ]
  }
}
