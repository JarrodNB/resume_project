      "css": ".ds-record{font-family:var(--font-sans,\"Geist Variable\",sans-serif);font-size:14px;display:grid;gap:5px;padding:24px 16px;border-top:1px solid var(--border);border-radius:8px;color:var(--foreground);text-decoration:none;transition:background-color 160ms}.ds-record strong{font-weight:550}.ds-record span{font-size:13px;color:var(--muted-foreground)}.ds-record:hover{background:var(--accent)}.ds-record:focus-visible{outline:3px solid color-mix(in oklab,var(--ring) 50%,transparent);outline-offset:1px;}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:0.01ms!important;transition-duration:0.01ms!important}}"
