# Copy to .env on the server and fill in. Never commit the real file.
REGISTRY=016170038537.dkr.ecr.us-east-2.amazonaws.com
TAG=latest
AWS_REGION=us-east-2
S3_UPLOADS_BUCKET=jobapp-uploads-016170038537
BACKUPS_BUCKET=jobapp-backups-016170038537
DOMAIN=careerdrafter.app

POSTGRES_PASSWORD=
API_DB_PASSWORD=
AI_READER_DB_PASSWORD=

# Rails session secret and the secrets shared between services.
SECRET_KEY_BASE=
INTERVIEW_SERVICE_SECRET=
AI_EXECUTION_SERVICE_SECRET=
MCP_TOOLS_SECRET=

# Outgoing account email (verification and password reset).
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# Stripe billing: live-mode secret key, the monthly price id (price_...) and the webhook signing
# secret (whsec_...) from the webhook endpoint https://api.<domain>/billing/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Hidden per-user caps on known AI spend per UTC day, in US dollars.
TRIAL_DAILY_AI_SPEND_CAP_USD=0.25
PAID_DAILY_AI_SPEND_CAP_USD=2.00

# Sign-up bot check and AI provider.
TURNSTILE_SECRET_KEY=
OPENAI_API_KEY=
