# Copy to .env on the server and fill in. Never commit the real file.
# Settings that are not secret (registry, buckets, domain) live in settings.env.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AI_READER_DB_PASSWORD=

# Rails session secret and the secrets shared between services.
SECRET_KEY_BASE=
INTERVIEW_SERVICE_SECRET=
AI_EXECUTION_SERVICE_SECRET=
MCP_TOOLS_SECRET=

# Outgoing account email (verification and password reset).
MAIL_FROM=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# Sign-up bot check and AI provider.
TURNSTILE_SECRET_KEY=
OPENAI_API_KEY=
