# Front door for the single server: terminates HTTPS and routes by hostname.
# Caddy gets and renews certificates by itself once DOMAIN points at this server.
# With the default DOMAIN=localhost it uses a self-signed certificate instead.

{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy landing:80
}

www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

app.{$DOMAIN:localhost} {
	encode zstd gzip

	# Browser WebSockets for AI streaming and interview transcription go to the AI app.
	@ai path /ai/executions/stream /interview-transcription/stream
	reverse_proxy @ai ai-http:8000

	reverse_proxy web:80
}

api.{$DOMAIN:localhost} {
	encode zstd gzip

	# /internal/* holds the AI service's callbacks. They are guarded only by a shared secret and
	# the AI service reaches them on the private network (http://api:3000), so they are not
	# served to the internet.
	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy api:3000
}
