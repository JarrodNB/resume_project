# Settings that are not secret. Committed, shipped to the server with each deploy, and read after
# .env, so a value here wins over the same name in the server's .env. Secrets stay in .env.
REGISTRY=016170038537.dkr.ecr.us-east-2.amazonaws.com
TAG=latest
AWS_REGION=us-east-2
S3_UPLOADS_BUCKET=jobapp-uploads-016170038537
BACKUPS_BUCKET=jobapp-backups-016170038537
DOMAIN=careerdrafter.app
SMTP_PORT=587

# AI models. Terra costs 10x Luna per token ($1 / $5 per million input / output tokens, against
# $0.10 / $0.50).
INTERVIEW_PREPARATION_MODEL=openai:gpt-6.1-terra
INTERVIEW_DIALOGUE_MODEL=openai:gpt-6.1-terra
RESUME_TAILORING_MODEL=openai:gpt-6.1-terra
