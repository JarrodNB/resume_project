# Description: Secrets for the AI worker. Copy to `services/ai/.env` (git-ignored) and fill in.
# Local wiring (SQS endpoint, read-only DB connection) is set in docker-compose.yml.
# Generative models default to openai:gpt-6-luna with low reasoning effort in worker/settings.py.
# Index:
#   - OPENAI_API_KEY: used by the Pydantic AI agents
#   - TYPESAFE_API_KEY: TypeSafe Jev, which screens user-written text before it enters a prompt.
#     Leave it blank to fail closed (the text is left out; nothing is sent).
#   - LOGFIRE_TOKEN: optional project write token for remote tracing and eval results.
#     LOGFIRE_ENVIRONMENT labels telemetry (development in docker-compose).
#     Without a token, startup remains noninteractive and remote export is disabled.
#   - CONVERSATION_LOGGING_ENABLED: set false to disable local Markdown transcripts.
#     WORKER_ENVIRONMENT=local is supplied only by development Compose.

OPENAI_API_KEY=
# Interview eval judge only; independent of generation model comparisons. One attempt.
EVAL_JUDGE_MODEL=openai:gpt-6.1-sol
TYPESAFE_API_KEY=
# Separate safety classifier used only after an attempted JEV failure.
USER_TEXT_SCREEN_FALLBACK_MODEL=openai:gpt-5-nano

LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
CONVERSATION_LOGGING_ENABLED=true

# The fake interview runtime is a separate Compose profile and does not read this file.
# Supply INTERVIEW_SERVICE_SECRET to Compose (and Rails), then use --profile interview-demo.
# It accepts INTERVIEW_FAKE_SCENARIO: normal, early-advance, continue-at-cap,
# blocked, unavailable, oversized. No model/provider setting enables paid calls.

# Queued question clarification claims Rails authority before any provider call.
# Use the same private service secret configured on Rails and the interview runtime.
INTERVIEW_RAILS_ORIGIN=http://api:3000
INTERVIEW_SERVICE_SECRET=
