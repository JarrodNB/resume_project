# Description: Secrets for the AI worker. Copy to `services/ai/.env` (git-ignored) and fill in.
# Local wiring (SQS endpoint, read-only DB connection) is set in docker-compose.yml.
# Generative models default to openai:gpt-6-luna with reasoning disabled in settings.py.
# Index:
#   - OPENAI_API_KEY: used by the Pydantic AI agents
#   - TYPESAFE_API_KEY: TypeSafe Jev, which screens user-written text before it enters a prompt.
#     Leave it blank to fail closed (the text is left out; nothing is sent).
#   - LOGFIRE_TOKEN: optional project write token for remote tracing and eval results.
#     LOGFIRE_ENVIRONMENT labels telemetry (development in docker-compose).
#     Without a token, startup remains noninteractive and remote export is disabled.
#   - CONVERSATION_LOGGING_ENABLED: set false to disable local Markdown transcripts.
#     WORKER_ENVIRONMENT=local is supplied only by development Compose.

OPENAI_API_KEY=
# Optional output transport for server-registered streaming features. Interviews stay final-only.
AI_STREAMING_ENABLED=false
AI_STREAM_REDIS_URL=redis://redis:6379/0
# Exact browser origins; defaults to INTERVIEW_BROWSER_ORIGINS when omitted.
AI_BROWSER_ORIGINS=http://localhost:5173
# Interview eval judge only; independent of generation model comparisons. One attempt.
EVAL_JUDGE_MODEL=openai:gpt-6.1-sol
TYPESAFE_API_KEY=
# Each screening choice accepts typesafe:jev-1.13.0,
# meta-llama/Llama-Prompt-Guard-2-22M, or llm.
# Provision gated model access or a Hugging Face cache for Llama.
USER_TEXT_SCREEN_MODEL=typesafe:jev-1.13.0
# Used only after an attempted primary screening failure; same model disables recovery.
USER_TEXT_SCREEN_FALLBACK_MODEL=llm
# Provider model used whenever either screening choice is llm.
USER_TEXT_SCREEN_LLM_MODEL=openai:gpt-5-nano
# Total seconds for one input, shared by primary and fallback; must be positive.
# Jev also keeps its three-second limit per individual call.
USER_TEXT_SCREEN_TIMEOUT_SECONDS=240

LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
CONVERSATION_LOGGING_ENABLED=true

# The offline fixture app uses docs/interview-recovery.compose.yml and does not read this file.
# Supply the same private INTERVIEW_SERVICE_SECRET to Rails and the AI HTTP app.
# It accepts INTERVIEW_FAKE_SCENARIO: normal, early-advance, continue-at-cap,
# blocked, unavailable, oversized. No model/provider setting enables paid calls.

# Shared HTTP execution is explicitly enabled and validates required provider credentials.
AI_HTTP_ENABLED=true

# Queued question clarification claims Rails authority before any provider call.
# Use the same private service secret configured on Rails and the interview runtime.
INTERVIEW_RAILS_ORIGIN=http://api:3000
INTERVIEW_SERVICE_SECRET=
# Optional secret for the generic execution/stream routes only; must match Rails.
# When unset, INTERVIEW_SERVICE_SECRET is used.
AI_EXECUTION_SERVICE_SECRET=

# Spoken runtime reasoning: false, true, minimal, low, medium, high, or xhigh.
# QA launcher reads this file. Root Compose reads these from the root .env or shell.
INTERVIEW_PREPARATION_THINKING=false
INTERVIEW_DIALOGUE_THINKING=false
