# Description: Local dev image for the AI worker. Source is bind-mounted by docker compose;
# the virtualenv lives in /opt/venv so the bind mount doesn't hide it.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
# Decode and inspect actual interview recordings with bounded local subprocesses.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
# A managed cloud build may mount its trusted proxy CA as a BuildKit secret.
# Ordinary developer builds keep the image's system certificate store.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      SSL_CERT_FILE=/run/secrets/proxy_ca uv sync --frozen; \
    else \
      uv sync --frozen; \
    fi

# The pinned model is installed by uv, never fetched while processing a resume.
# Fail the build if the local English NLP assets cannot load on this Python version.
RUN python -c "import spacy; spacy.load('en_core_web_sm')"

CMD ["python", "-m", "worker.main"]
