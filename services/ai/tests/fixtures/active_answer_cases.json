{
  "description": "Shared by RSpec (InterviewPrep::ActiveAnswer), pytest (the question reader's SQL and helper) and the web tests. The active answer is the selected format's draft, projected as text. A question is answered only when that text has a character outside Ruby's [[:space:]] set: tab, newline, vertical tab, form feed, carriage return, space, U+0085, U+00A0, U+1680, U+2000-U+200A, U+2028, U+2029, U+202F, U+205F and U+3000. U+FEFF, U+180E, U+200B and U+001C-U+001F are text. Inactive drafts never count.",
  "answers": [
    {
      "name": "plain text with words",
      "format": "plain_text",
      "drafts": {
        "plain_text": {
          "text": "I led a migration."
        }
      },
      "text": "I led a migration.",
      "answered": true
    },
    {
      "name": "empty plain text",
      "format": "plain_text",
      "drafts": {
        "plain_text": {
          "text": ""
        }
      },
      "text": "",
      "answered": false
    },
    {
