# Description: Secrets for the Rails API. Copy to `services/api/.env` (git-ignored) and fill in.
# Local wiring (DB_HOST, DB_USERNAME, DB_PASSWORD, SQS endpoint) is set in docker-compose.yml.
# In production these come from the server's secret store (AWS Secrets Manager / SSM).
# Index:
#   - CORS_ORIGINS: comma-separated allowed origins (defaults to http://localhost:5173)
#   - TRIAL_DAILY_AI_SPEND_CAP_USD, PAID_DAILY_AI_SPEND_CAP_USD: hidden per-user cap on known AI spend per UTC day,
#     shared by general AI and spoken interviews (users.daily_ai_spend_cap_microdollars overrides it)
#   - AI_TASKS_PER_HOUR, AI_MAX_IN_FLIGHT_TASKS: general AI start and in-flight limits per user
#   - INTERVIEW_SESSIONS_PER_HOUR, INTERVIEW_MAX_IN_FLIGHT_OPERATIONS: the same for spoken interviews
#   - AI_SITE_DAILY_BUDGET_USD: known trial-user AI spend allowed across all users per UTC day; 0 stops new trial AI work
#   - SIGN_UP_DOMAIN_DAILY_LIMIT: new accounts one non-public email domain may create per day
#   - TURNSTILE_SECRET_KEY: server half of the sign-up bot check. The value below is Cloudflare's
#     always-pass test secret, for development only. Production sign-up fails closed without a real one.
#   - TRUSTED_PROXY_CIDRS: comma-separated public proxy ranges in front of the API, such as
#     https://www.cloudflare.com/ips/. Rate limits skip these to find the real client IP.
#   - STRIPE_SECRET_KEY, STRIPE_PRICE_ID, STRIPE_WEBHOOK_SECRET: Stripe Checkout and webhooks (test-mode values
#     locally; see docs/testing.md "Billing in Stripe test mode"). Without the first two, Upgrade says billing
#     isn't available. STRIPE_PRICE_ID is the monthly price. The webhook secret (whsec_...) signs webhooks.
#   - OPENAI_API_KEY: embeds career library entries (CareerLibrary::SyncLibraryEmbeddingsJob);
#     without it, embedding syncs are skipped
#   - CLEANJOBDATA_API_KEY: server-only bearer key for US Job Board searches
#   - EMBEDDING_MODEL: optional, defaults to text-embedding-3-small (must match the AI worker's)

OPENAI_API_KEY=
CLEANJOBDATA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TRUSTED_PROXY_CIDRS=
# Account mail: development uses Letter Opener Web at http://localhost:3000/letter_opener (no SMTP credentials needed).
# Production requires HTTPS WEB_APP_URL, verified MAIL_FROM and authenticated STARTTLS SMTP.
WEB_APP_URL=http://localhost:5173
MAIL_FROM=Careerdrafter <accounts@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
TRIAL_DAILY_AI_SPEND_CAP_USD=0.25
PAID_DAILY_AI_SPEND_CAP_USD=2.00
AI_TASKS_PER_HOUR=40
AI_MAX_IN_FLIGHT_TASKS=2
AI_SITE_DAILY_BUDGET_USD=5.00
SIGN_UP_DOMAIN_DAILY_LIMIT=20

# Independent spoken-interview start and in-flight limits per user.
INTERVIEW_SESSIONS_PER_HOUR=10
INTERVIEW_MAX_IN_FLIGHT_OPERATIONS=3

# Private FastAPI-to-Rails interview execution callbacks. Use a separate random secret.
# Leave unset to disable the internal API; never expose this value to the browser.
INTERVIEW_SERVICE_SECRET=
# Optional secret for the generic AI execution nudge and stream callbacks only.
# Must match the AI service. When unset, INTERVIEW_SERVICE_SECRET is used.
AI_EXECUTION_SERVICE_SECRET=
AI_HTTP_ORIGIN=http://ai-http:8000
# Maximum potentially charged provider calls per claimed execution (1–20, default 8).
INTERVIEW_PROVIDER_ATTEMPT_LIMIT=8
# Browser-reachable storage origin is signed directly; executor grants use S3_ENDPOINT_URL.
# Set the published QA port here when it differs from the default Compose port.
INTERVIEW_BROWSER_STORAGE_ORIGIN=http://localhost:9090
# Private audio bytes, configurable downward from the 10 MiB recording ceiling.
INTERVIEW_RECORDING_MAX_BYTES=10485760
# Local spoken-interview testing only. False by default; ignored outside development.
# Records all costs/estimates but skips verification unknown/$5 and interview spend/start gates.
# Resource concurrency, execution caps, ownership and general AI limits remain active.
INTERVIEW_LOCAL_TESTING_UNMETERED=false

# Browser voice is default. Set provider to retain generated OpenAI speech playback.
INTERVIEW_SPEECH_PLAYBACK=browser

# Career chat limits; accepted user messages determine the rolling-summary cadence.
CHAT_MAX_INPUT_CHARACTERS=10000
CHAT_SUMMARIZE_EVERY_USER_MESSAGES=20
