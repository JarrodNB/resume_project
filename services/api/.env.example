# Description: Secrets for the Rails API. Copy to `services/api/.env` (git-ignored) and fill in.
# Local wiring (DB_HOST, DB_USERNAME, DB_PASSWORD, SQS endpoint) is set in docker-compose.yml.
# In production these come from Kubernetes secrets.
# Index:
#   - CORS_ORIGINS: comma-separated allowed origins (defaults to http://localhost:5173)
#   - AI_MONTHLY_BUDGET_USD, AI_TASKS_PER_HOUR, AI_MAX_IN_FLIGHT_TASKS: default per-user AI limits
#     (general AI only; per-user override columns on users win)
#   - INTERVIEW_MONTHLY_BUDGET_USD, INTERVIEW_SESSIONS_PER_HOUR, INTERVIEW_MAX_IN_FLIGHT_OPERATIONS:
#     separate spoken-interview limits; general AI usage and overrides do not affect them
#   - OPENAI_API_KEY: embeds career library entries (CareerLibrary::SyncLibraryEmbeddingsJob);
#     without it, embedding syncs are skipped
#   - CLEANJOBDATA_API_KEY: server-only bearer key for US Job Board searches
#   - EMBEDDING_MODEL: optional, defaults to text-embedding-3-small (must match the AI worker's)

OPENAI_API_KEY=
CLEANJOBDATA_API_KEY=
CORS_ORIGINS=http://localhost:5173
# Account mail: development uses Letter Opener Web at http://localhost:3000/letter_opener (no SMTP credentials needed).
# Production requires HTTPS WEB_APP_URL, verified MAIL_FROM and authenticated STARTTLS SMTP.
WEB_APP_URL=http://localhost:5173
MAIL_FROM=Careergrind <accounts@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
AI_MONTHLY_BUDGET_USD=2.00
AI_TASKS_PER_HOUR=10
AI_MAX_IN_FLIGHT_TASKS=2

# Independent spoken-interview allowance per user, including every preparation/turn/speech bill.
INTERVIEW_MONTHLY_BUDGET_USD=3.00
INTERVIEW_SESSIONS_PER_HOUR=30
INTERVIEW_MAX_IN_FLIGHT_OPERATIONS=3

# Private FastAPI-to-Rails interview execution callbacks. Use a separate random secret.
# Leave unset to disable the internal API; never expose this value to the browser.
INTERVIEW_SERVICE_SECRET=
AI_HTTP_ORIGIN=http://ai-http:8000
INTERVIEW_ADMISSION_ENABLED=true
# Maximum potentially charged provider calls per claimed execution (1–20, default 8).
INTERVIEW_PROVIDER_ATTEMPT_LIMIT=8
# Browser-reachable storage origin is signed directly; executor grants use S3_ENDPOINT_URL.
# Set the published QA port here when it differs from the default Compose port.
INTERVIEW_BROWSER_STORAGE_ORIGIN=http://localhost:9090
# Private audio bytes, configurable downward from the 10 MiB recording ceiling.
INTERVIEW_RECORDING_MAX_BYTES=10485760
# Local spoken-interview testing only. False by default; ignored outside development.
# Records all costs/estimates but skips verification unknown/$5 and interview spend/start gates.
# Resource concurrency, execution caps, ownership and general AI limits remain active.
INTERVIEW_LOCAL_TESTING_UNMETERED=false

# Browser voice is default. Set provider to retain generated OpenAI speech playback.
INTERVIEW_SPEECH_PLAYBACK=browser
