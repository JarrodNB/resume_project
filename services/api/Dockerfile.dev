# Description: Local dev image for the Rails API. Source is bind-mounted by docker compose.
# The generated `Dockerfile` next to this one is the production image.
FROM ruby:3.4.11

WORKDIR /rails

COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["bash", "-c", "rm -f tmp/pids/server.pid && bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p 3000"]
